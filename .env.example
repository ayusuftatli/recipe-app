# Local defaults; on Railway use /data/recipes.db and /data/photos
DATABASE_PATH=./data/recipes.db
PHOTO_DIR=./data/photos
APP_PASSWORD=
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
OPENROUTER_API_KEY=
# Must support JSON-schema output and image input, e.g. google/gemini-2.5-flash
LLM_MODEL=
# Optional: override the OpenRouter API base URL (e.g. for a local mock)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FDC_API_KEY=
# Public URL, e.g. https://recipes.example.up.railway.app
ORIGIN=
# Behind a reverse proxy (Railway): where adapter-node reads the client IP for rate limiting
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
# Max request body for adapter-node (photo uploads); the Docker image sets 20M
BODY_SIZE_LIMIT=20M
